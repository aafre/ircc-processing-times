---
import Base from '../layouts/Base.astro';
import SEOHead from '../components/SEOHead.astro';
---

<Base>
  <SEOHead
    slot="head"
    title="Page Not Found — IRCC Processing Time Tracker"
    description="This page doesn't exist. Browse Canada visa processing times for 200+ countries."
  />

  <section class="section">
    <div class="container">
      <h1 style="font-size: clamp(2rem, 4vw, 3.5rem); font-weight: 200;">
        Page <span style="font-weight: 800;">Not Found</span>
      </h1>
      <p style="color: var(--text-secondary); margin-top: var(--space-md);">
        This page doesn't exist. <a href="/processing-times/">Browse all countries →</a>
      </p>
    </div>
  </section>
</Base>
